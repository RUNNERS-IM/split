{
  "name": "split",
  "version": "2.6.111301",
  "private": true,
  "description": "Window arranging app by RUNNERS",
  "homepage": "https://github.com/RUNNERS-IM/split",
  "license": "UNLICENSED",
  "author": "RUNNERS",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "native": "napi build --manifest-path native/Cargo.toml --package-json-path native/package.json --platform --release --output-dir native --no-js",
    "dev": "electron-vite dev",
    "build": "pnpm check:account && electron-vite build",
    "check:account": "node src/renderer/runners-account/check.mjs && node src/main/runners/check.mjs",
    "test": "vitest run",
    "lint": "oxlint -c .oxlintrc.split.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "relay": "tsx test/relay-server.ts",
    "dist:mac": "pnpm run native:mac-universal && pnpm check:account && electron-vite build && electron-builder --mac --config builder.config.cjs",
    "dist:mas": "pnpm run native:mac-universal && pnpm check:account && electron-vite build && electron-builder --mac mas:universal --config builder.config.cjs",
    "native:mac-universal": "sh scripts/native-mac-universal.sh",
    "dist:win": "pnpm run native && pnpm check:account && electron-vite build && electron-builder --win --config builder.config.cjs",
    "dist:linux": "pnpm run native && pnpm check:account && electron-vite build && electron-builder --linux --config builder.config.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "electron-updater": "^6.8.10"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "43.8.6",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.63.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.93.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "ws": "^8.22.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.14.0",
  "productName": "Split"
}
